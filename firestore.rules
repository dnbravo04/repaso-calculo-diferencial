rules_version = '2';
// Cada usuario solo puede leer y escribir su propio documento: usuarios/{su uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['datos', 'actualizado'])
        && request.resource.data.datos is string
        && request.resource.data.datos.size() < 900000;
    }
  }
}
